FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS go

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

# OpenCode's reviewed Linux x64 release is installed directly rather than
# building or auto-updating provider code at runtime.
ADD --checksum=sha256:d910c3ed7613bb5791a328904615d41cc25b7d3a6b470e3199ab0426a995b38a \
    https://github.com/anomalyco/opencode/releases/download/v1.18.21/opencode-linux-x64.tar.gz \
    /tmp/opencode.tar.gz
COPY --from=go /usr/local/go /usr/local/go
COPY --chmod=0444 opencode-managed.json /etc/opencode/opencode.json

RUN chmod 0555 /etc/opencode \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git make ripgrep \
    && tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin \
    && test "$(/usr/local/bin/opencode --version)" = "1.18.21" \
    && mkdir -p /var/lib/opencode /workspace \
    && chown -R 65532:65532 /var/lib/opencode /workspace \
    && rm -f /tmp/opencode.tar.gz \
    && rm -rf /var/lib/apt/lists/*

ENV HOME=/var/lib/opencode \
    XDG_DATA_HOME=/var/lib/opencode/data \
    XDG_CONFIG_HOME=/var/lib/opencode/config \
    XDG_CACHE_HOME=/var/lib/opencode/cache \
    OPENCODE_CONFIG=/etc/opencode/opencode.json \
    PATH=/usr/local/go/bin:$PATH

USER 65532:65532
WORKDIR /workspace
EXPOSE 4096
ENTRYPOINT ["/usr/local/bin/opencode"]
CMD ["serve", "--hostname", "0.0.0.0", "--port", "4096"]
