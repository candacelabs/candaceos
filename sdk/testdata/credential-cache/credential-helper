#!/usr/bin/env bash
set -euo pipefail

[[ ${1:-} == get ]] || exit 1
printf 'get\n' >>/credential-test-state/helper.log

# The production helper deliberately accepts only api.github.com. This test
# adapter preserves that boundary while the acceptance server remains local.
printf '%s\n' '{"uri":"https://api.github.com/repos/example-org/example-repo/releases/assets/1001"}' |
  /workspace/tools/github-credential-helper get
