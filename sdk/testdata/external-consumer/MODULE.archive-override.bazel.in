module(name = "candaceos_archive_override_consumer")

bazel_dep(name = "candaceos", version = "0.0.0")
bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "rules_go", version = "0.62.0")

archive_override(
    module_name = "candaceos",
    integrity = "@CANDACEOS_ARCHIVE_INTEGRITY@",
    strip_prefix = "@CANDACEOS_ARCHIVE_PREFIX@",
    urls = ["@CANDACEOS_ARCHIVE_URL@"],
)

# The consumer declares only its direct test/runtime dependencies. The
# archive's own MODULE.bazel supplies Core's complete dependency closure.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_onsi_ginkgo_v2",
    "com_github_onsi_gomega",
    "org_golang_google_protobuf",
    "org_uber_go_mock",
)
