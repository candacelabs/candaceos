module(name = "candaceos_external_consumer")

bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "rules_go", version = "0.62.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.5")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

http_archive(
    name = "candaceos",
    sha256 = "@CANDACEOS_ARCHIVE_SHA256@",
    strip_prefix = "@CANDACEOS_ARCHIVE_PREFIX@",
    urls = ["@CANDACEOS_ARCHIVE_URL@"],
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "@candaceos//:go.mod")

use_repo(
    go_deps,
    "com_github_gin_gonic_gin",
    "com_github_github_copilot_sdk_go",
    "com_github_google_uuid",
    "com_github_jackc_pgx_v5",
    "com_github_nats_io_nats_go",
    "com_github_onsi_ginkgo_v2",
    "com_github_onsi_gomega",
    "com_github_penglongli_gin_metrics",
    "com_github_prometheus_client_golang",
    "com_github_redis_go_redis_v9",
    "com_github_rs_zerolog",
    "com_github_soheilhy_cmux",
    "com_github_sst_opencode_sdk_go",
    "in_gopkg_yaml_v3",
    "io_opentelemetry_go_otel_sdk",
    "io_opentelemetry_go_otel_trace",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_net",
    "org_uber_go_mock",
)
